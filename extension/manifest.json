{
  "manifest_version": 3,
  "name": "Ofertix — Aprovações",
  "version": "1.0.0",
  "description": "Aprove e gerencie ofertas do Ofertix em uma janela flutuante em qualquer site.",
  "icons": {
    "48": "icons/ofertix.svg",
    "128": "icons/ofertix.svg"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://pndbombvfrxpyqnraqsy.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "panel.js",
        "styles.css",
        "config.js",
        "icons/ofertix.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}